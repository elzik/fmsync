{
  "WatcherOptions": {
    "WatchedDirectoryPaths": ["../../../../TestFiles"]
  },
  "FileSystemOptions": {
    "FilenamePattern": "*.md"
  },
  "FrontMatterOptions": {
    "TimeZoneId": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/Elzik.FmSync.Worker.log"
        }
      }
    ]
  }
}
